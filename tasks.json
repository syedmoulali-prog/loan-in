{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Spring Boot Backend",
      "type": "shell",
      "command": "cmd /c \"cd /d backend && mvnw.cmd spring-boot:run\"",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*Starting LoanEligibilityApplication.*",
          "endsPattern": ".*Started LoanEligibilityApplication.*"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Start React Frontend",
      "type": "shell",
      "command": "cmd /c \"cd /d frontend && npm.cmd run dev\"",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".*VITE v.*ready in.*",
          "endsPattern": ".*Local:.*http://localhost:5173/.*"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": false
      }
    },
    {
      "label": "Run All (Backend + Frontend)",
      "dependsOn": [
        "Start Spring Boot Backend",
        "Start React Frontend"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Run Backend Tests",
      "type": "shell",
      "command": "cmd /c \"cd /d backend && mvnw.cmd test\"",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Build Frontend",
      "type": "shell",
      "command": "cmd /c \"cd /d frontend && npm.cmd run build\"",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
